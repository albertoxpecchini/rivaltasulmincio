{
  // F5: avvia `npm run dev` (task «sito: server»), aspetta che Vite sia in ascolto
  // e apre il sito in Edge col debugger attaccato.
  //
  // Il sito sta in rivaltasulmincio.it/, non qui alla radice: i percorsi
  // sotto puntano là dentro.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Sito (F5)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/rivaltasulmincio.it",
      "preLaunchTask": "sito: pronto",
      // Il debugger, di suo, spegne la cache del browser: ogni tile della
      // mappa si riscarica a ogni ricarica della pagina, contro la Tile Usage
      // Policy di OpenStreetMap, che per questo può rispondere 403 «Access blocked».
      "disableNetworkCache": false,
      "sourceMapPathOverrides": {
        "/src/*": "${workspaceFolder}/rivaltasulmincio.it/src/*"
      }
    },
    {
      "name": "Prerender (build)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/rivaltasulmincio.it/scripts/prerender.ts",
      "cwd": "${workspaceFolder}/rivaltasulmincio.it",
      "console": "integratedTerminal"
    }
  ]
}
