{
  "version": "2.0.0",
  "tasks": [
    {
      // `npm run dev` come task in background: resta vivo dopo F5.
      // Il `problemMatcher` dice a VS Code quando Vite è in ascolto,
      // così il browser non parte prima che il server risponda.
      //
      // `path` punta alla sottocartella: il package.json sta là.
      "label": "dev",
      "type": "npm",
      // `--port 5173 --strictPort`: senza, se la porta è occupata Vite
      // passa alla 5174 e il browser aprirebbe l'URL sbagliato. Meglio
      // un errore chiaro che una pagina muta.
      "script": "dev -- --port 5173 --strictPort",
      "path": "rivaltasulmincio.it",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(?!x)x$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          // Non «Local:.*http»: Vite colora l'output e infila codici ANSI
          // fra «Local» e i due punti, quindi i due punti non combaciano.
          "endsPattern": "Local.*http"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    },
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "path": "rivaltasulmincio.it",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "typecheck",
      "type": "npm",
      "script": "typecheck",
      "path": "rivaltasulmincio.it",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$tsc"]
    }
  ]
}
