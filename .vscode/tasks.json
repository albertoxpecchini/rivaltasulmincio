{
  "version": "2.0.0",
  // I task non usano il tipo «npm» con la proprietà «path»: quella
  // dipende dal rilevamento automatico degli script di VS Code e può
  // ricadere in silenzio sulla cartella aperta — che qui non ha un
  // package.json, e npm muore con ENOENT. Qui la cartella di lavoro è
  // detta a chiare lettere in «options.cwd», che è sempre rispettata.
  "tasks": [
    {
      // Quello che F5 lancia davvero: prima accende il server, poi
      // aspetta che risponda. Il browser parte solo dopo.
      "label": "sito: pronto",
      "dependsOn": ["sito: server", "sito: attendi"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      // Il server. Resta acceso dopo F5, così non si ricompila tutto
      // a ogni avvio. Per spegnerlo: cestino nel pannello Terminale.
      //
      // La porta è fissata dentro lo script «dev» del package.json.
      "label": "sito: server",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/rivaltasulmincio.it" },
      "isBackground": true,
      // Pattern che non combaciano mai, più «activeOnStart»: il task è
      // considerato «avviato» subito e non blocca la sequenza. Non si
      // tenta di capire dall'output quando Vite è pronto — è colorato e
      // cambia da una versione all'altra. Lo stabilisce «sito: attendi».
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^(?!x)x$", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^(?!x)x$",
          "endsPattern": "^(?!x)x$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    },
    {
      // Interroga la porta finché la pagina non risponde. Se il server
      // non parte, qui esce con errore e dice cosa guardare, invece di
      // lasciare VS Code appeso per sempre.
      "label": "sito: attendi",
      "type": "process",
      "command": "node",
      "args": ["${workspaceFolder}/scripts/attendi-dev.mjs", "http://localhost:5173/"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "dev",
        "close": true
      }
    },
    {
      "label": "build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/rivaltasulmincio.it" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "typecheck",
      "type": "shell",
      "command": "npm run typecheck",
      "options": { "cwd": "${workspaceFolder}/rivaltasulmincio.it" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$tsc"]
    }
  ]
}
