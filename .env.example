# Modello per il file .env — copiare in `.env` (che git ignora) e riempire.
# Serve SOLO all'anteprima locale (`npm run dev`): in produzione queste
# variabili le mette Vercel in Settings → Environment Variables.
#
# Senza questo file la pagina /iscritti in locale risponde
# «zona iscritti non configurata: manca ISCRITTI_CHIAVE».

# La chiave degli organizzatori per entrare in /iscritti. In locale la si
# inventa: basta che sia la stessa che si digita nella porta della pagina.
ISCRITTI_CHIAVE=chiave-di-prova-degli-organizzatori

# La Secret key di Stripe. `sk_test_…` per leggere i pagamenti di prova senza
# toccare quelli veri (Stripe → Developers → API keys).
STRIPE_SECRET_KEY=sk_test_...

# Facoltative — servono solo per provare in locale anche le mail di conferma
# (/api/conferma-color-walk). Vedi README, sezione «E perché le mail partano».
# STRIPE_WEBHOOK_SECRET=whsec_...
# RESEND_API_KEY=re_...
# POSTA_MITTENTE=Color Walk — Rivalta sul Mincio <color-walk@rivaltasulmincio.it>
