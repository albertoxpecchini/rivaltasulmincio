<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <link rel="icon" href="/img/favicon.png" type="image/png" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Editor – Rivalta sul Mincio</title>
  <meta name="robots" content="noindex" />
  <link rel="stylesheet" href="/vendor/bootstrap-italia/css/bootstrap-italia.min.css" />
  <link rel="stylesheet" href="/rsm-bi.css" />
  <style>
    /* ── celle compatte ── */
    .field-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1px;
      background: #dde3ea;
      border: 1px solid #dde3ea;
      border-radius: 8px;
      overflow: hidden;
    }
    .field-grid .f-cell {
      background: #fff;
      padding: 8px 10px;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    .field-grid .f-cell.span2 { grid-column: span 2; }
    .field-grid .f-cell.span3 { grid-column: span 3; }
    .field-grid .f-cell label {
      font-size: .68rem;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: #5a6882;
      margin: 0;
      white-space: nowrap;
    }
    .field-grid .f-cell input,
    .field-grid .f-cell select,
    .field-grid .f-cell textarea {
      border: none;
      outline: none;
      font-size: .9rem;
      padding: 0;
      background: transparent;
      color: #17324d;
      width: 100%;
      font-family: inherit;
    }
    .field-grid .f-cell input:focus,
    .field-grid .f-cell select:focus,
    .field-grid .f-cell textarea:focus {
      background: #f0f5ff;
      margin: -8px -10px;
      padding: 8px 10px;
      border-radius: 0;
      outline: 2px solid #06c;
      outline-offset: -2px;
    }
    .field-grid .f-cell textarea {
      resize: none;
      line-height: 1.5;
    }
    .field-grid .f-cell .char-hint {
      font-size: .65rem;
      color: #8a9bb0;
      text-align: right;
      margin-top: 2px;
    }

    /* ── accordion section ── */
    .w-section { border: 1px solid #dde3ea; border-radius: 10px; overflow: hidden; margin-bottom: .5rem; }
    .w-section summary {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      font-size: .8rem;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: #17324d;
      background: #f5f7fa;
      cursor: pointer;
      list-style: none;
      user-select: none;
    }
    .w-section summary::-webkit-details-marker { display: none; }
    .w-section summary .arrow {
      margin-left: auto;
      font-size: .7rem;
      color: #8a9bb0;
      transition: transform .15s;
    }
    .w-section[open] summary .arrow { transform: rotate(90deg); }
    .w-section summary .badge-num {
      font-size: .65rem;
      background: #e3e8f0;
      color: #5a6882;
      border-radius: 99px;
      padding: 1px 7px;
      font-weight: 600;
    }
    .w-section .section-body { padding: 10px; background: #fff; }

    /* ── testo completo separato ── */
    #f-content {
      width: 100%;
      font-family: inherit;
      font-size: .9rem;
      line-height: 1.65;
      border: none;
      outline: none;
      padding: 10px;
      resize: vertical;
      min-height: 180px;
      background: transparent;
      color: #17324d;
    }
    #f-content:focus {
      outline: 2px solid #06c;
      outline-offset: -2px;
      background: #f8fbff;
    }
    .content-wrap { background: #fff; border: 1px solid #dde3ea; border-radius: 10px; overflow: hidden; margin-bottom: .5rem; }
    .content-header { padding: 10px 14px; background: #f5f7fa; font-size: .8rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #17324d; }
    .content-hint { padding: 6px 14px; font-size: .72rem; color: #8a9bb0; background: #f5f7fa; border-bottom: 1px solid #eaedf1; }

    /* ── azioni sticky ── */
    .sticky-bar {
      position: sticky;
      bottom: 0;
      background: #fff;
      border-top: 1px solid #dde3ea;
      padding: .6rem 0;
      margin-top: .5rem;
      z-index: 20;
    }

    /* ── anteprima post ── */
    #preview-pane {
      position: sticky;
      top: 76px;
      max-height: calc(100vh - 100px);
      overflow-y: auto;
    }
    .preview-shell {
      border: 1px solid #dde3ea;
      border-radius: 10px;
      overflow: hidden;
    }
    .preview-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 12px;
      background: #f5f7fa;
      border-bottom: 1px solid #dde3ea;
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: #5a6882;
    }
    .preview-body {
      padding: 20px 18px;
      background: #fff;
      font-size: .9rem;
    }
    /* mini post render */
    .pv-badges { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: .7rem; }
    .pv-meta { font-size: .78rem; color: #5a6882; display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: .6rem; }
    .pv-title { font-size: 1.35rem; font-weight: 700; color: #17324d; line-height: 1.25; margin-bottom: .5rem; }
    .pv-subtitle { font-size: .95rem; color: #45526b; margin-bottom: .75rem; font-style: italic; }
    .pv-lead { font-size: .9rem; color: #45526b; border-left: 3px solid #06c; padding-left: 12px; margin-bottom: 1rem; }
    .pv-cover { width: 100%; border-radius: 8px; margin-bottom: 1rem; max-height: 180px; object-fit: cover; display: block; }
    .pv-cover-empty { width: 100%; height: 120px; border-radius: 8px; margin-bottom: 1rem; background: linear-gradient(135deg, #0b1626, #1e2338); display: flex; align-items: center; justify-content: center; color: #5a7a8a; font-size: .75rem; }
    .pv-content { font-size: .88rem; line-height: 1.7; color: #3b4c60; white-space: pre-wrap; word-break: break-word; }
    .pv-meta-table { margin-top: 1rem; border-top: 1px solid #e8ecf2; padding-top: .75rem; display: grid; grid-template-columns: 1fr 1fr; gap: 4px 12px; font-size: .75rem; }
    .pv-meta-table dt { color: #8a9bb0; font-weight: 600; }
    .pv-meta-table dd { color: #17324d; margin: 0; }
    .pv-cta { display: inline-block; margin-top: .75rem; padding: 7px 16px; background: #06c; color: #fff; border-radius: 6px; font-size: .82rem; font-weight: 600; text-decoration: none; }
    .pv-empty { color: #8a9bb0; font-size: .82rem; text-align: center; padding: 2rem 0; }
    .pv-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: .75rem; }
    .pv-tag { font-size: .7rem; background: #e8f0fe; color: #0a4dae; border-radius: 99px; padding: 2px 9px; font-weight: 600; }

    /* ── upload immagine ── */
    .img-upload-area {
      border: 2px dashed #c8d2de;
      border-radius: 8px;
      padding: 14px 12px;
      display: flex;
      align-items: center;
      gap: 12px;
      background: #f8fafc;
      cursor: pointer;
      transition: border-color .15s, background .15s;
    }
    .img-upload-area:hover, .img-upload-area.drag-over {
      border-color: #06c;
      background: #f0f5ff;
    }
    .img-upload-area.has-image {
      border-style: solid;
      border-color: #a8c4f0;
    }
    .img-upload-thumb {
      width: 56px;
      height: 40px;
      object-fit: cover;
      border-radius: 5px;
      flex-shrink: 0;
      display: none;
    }
    .img-upload-thumb.visible { display: block; }
    .img-upload-placeholder {
      width: 56px;
      height: 40px;
      border-radius: 5px;
      background: #e3e8f0;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #8a9bb0;
      font-size: 1.1rem;
    }
    .img-upload-info { flex: 1; min-width: 0; }
    .img-upload-info .up-label {
      font-size: .78rem;
      font-weight: 600;
      color: #17324d;
    }
    .img-upload-info .up-sub {
      font-size: .68rem;
      color: #8a9bb0;
      margin-top: 2px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .img-upload-progress {
      height: 3px;
      background: #e0e8f0;
      border-radius: 99px;
      margin-top: 6px;
      display: none;
    }
    .img-upload-progress.visible { display: block; }
    .img-upload-progress-bar {
      height: 3px;
      background: #06c;
      border-radius: 99px;
      width: 0%;
      transition: width .2s;
    }
    .img-upload-actions { display: flex; gap: 6px; flex-shrink: 0; }
    .img-upload-actions button {
      font-size: .72rem;
      padding: 4px 10px;
      border-radius: 5px;
      border: 1px solid #c8d2de;
      background: #fff;
      color: #17324d;
      cursor: pointer;
      white-space: nowrap;
    }
    .img-upload-actions button:hover { background: #f0f5ff; border-color: #06c; color: #06c; }
    .img-upload-actions button.danger:hover { background: #fff5f5; border-color: #cc1f1f; color: #cc1f1f; }
    /* ── AI status bar ── */
    .ai-status-bar { margin-top: 8px; padding: 8px 12px; border-radius: 6px; font-size: .78rem; font-weight: 600; display: none; align-items: center; gap: 8px; }
    .ai-status-bar.reading { display: flex; background: #eef3ff; color: #0a4dae; border: 1px solid #c5d5f8; }
    .ai-status-bar.done    { display: flex; background: #e6f9f0; color: #1a6e40; border: 1px solid #9dd9be; }
    .ai-status-bar.error   { display: flex; background: #fff8e6; color: #7a5200; border: 1px solid #f5d97a; }
    .ai-spin { display: inline-block; width: 12px; height: 12px; border: 2px solid currentColor; border-top-color: transparent; border-radius: 50%; animation: ai-rotate .7s linear infinite; flex-shrink: 0; }
    @keyframes ai-rotate { to { transform: rotate(360deg); } }
    .img-url-row { margin-top: 8px; }
    .img-url-row label {
      font-size: .65rem;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      color: #8a9bb0;
      display: block;
      margin-bottom: 2px;
    }
    .img-url-row input {
      width: 100%;
      font-size: .8rem;
      border: 1px solid #dde3ea;
      border-radius: 5px;
      padding: 5px 8px;
      color: #5a6882;
      background: #f8fafc;
      font-family: inherit;
    }
    .img-url-row input:focus { outline: 2px solid #06c; outline-offset: -1px; }

    /* ── JSON editor ── */
    .json-pane {
      background: #0d1117;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid #30363d;
    }
    .json-pane-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 7px 12px;
      background: #161b22;
      border-bottom: 1px solid #30363d;
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: .07em;
      text-transform: uppercase;
      color: #7d8590;
    }
    .json-pane-header .json-badge {
      font-size: .65rem;
      background: #21262d;
      color: #58a6ff;
      border-radius: 4px;
      padding: 1px 7px;
      font-weight: 600;
      letter-spacing: 0;
      text-transform: none;
    }
    #f-json-payload {
      width: 100%;
      min-height: 260px;
      padding: 14px 16px;
      background: #0d1117;
      color: #e6edf3;
      font-family: 'Consolas', 'JetBrains Mono', 'Courier New', monospace;
      font-size: .82rem;
      line-height: 1.7;
      border: none;
      outline: none;
      resize: vertical;
      display: block;
      tab-size: 2;
    }
    #f-json-payload:focus { background: #0d1117; outline: 2px solid #1f6feb; outline-offset: -2px; }
    .json-hint { padding: 6px 12px 8px; font-size: .66rem; color: #484f58; background: #0d1117; }
    /* ── sezione AI ── */
    .ai-result-ok { font-size: .72rem; padding: 6px 10px; border-radius: 5px; background: #e6f5ec; color: #1a6630; border: 1px solid #b8dfc6; margin-top: 8px; display: none; }
    .ai-result-ok.visible { display: block; }

    /* ── AI gemini glow border ── */
    .ai-glow-wrap {
      position: relative;
      border-radius: 14px;
      padding: 2px;
      overflow: hidden;
      margin-bottom: 4px;
    }
    .ai-glow-wrap::before {
      content: '';
      position: absolute;
      inset: -120%;
      width: 340%;
      height: 340%;
      background: conic-gradient(from 0deg,
        #4285f4 0%, #8b5cf6 20%, #f43f5e 40%,
        #f97316 55%, #10b981 70%, #06b6d4 85%, #4285f4 100%);
      animation: ai-spin-border 6s linear infinite;
      opacity: .65;
    }
    .ai-glow-inner {
      position: relative;
      z-index: 1;
      background: #f8fafc;
      border-radius: 12px;
      padding: 14px;
    }
    @keyframes ai-spin-border { to { transform: rotate(360deg); } }

    /* ── volantino upload area ── */
    .vol-upload-area { border: 2px dashed #c8d2de; border-radius: 8px; padding: 14px 12px; display: flex; align-items: center; gap: 12px; background: #f8fafc; cursor: pointer; transition: border-color .15s, background .15s; }
    .vol-upload-area:hover, .vol-upload-area.drag-over { border-color: #06c; background: #f0f5ff; }
    .vol-upload-area.has-file { border-style: solid; border-color: #a8c4f0; background: #f0f5ff; }
    .vol-icon { font-size: 1.4rem; flex-shrink: 0; }
    .vol-info { flex: 1; min-width: 0; }
    .vol-info .vup-label { font-size: .78rem; font-weight: 600; color: #17324d; }
    .vol-info .vup-sub { font-size: .67rem; color: #8a9bb0; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  </style>
</head>
<body>
<!--PARTIAL:nav-->

<main class="container rsm-page">

  <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div>
      <p class="text-primary fw-semibold text-uppercase small mb-0">Editor · Rivalta sul Mincio</p>
      <h1 class="h4 mb-0" id="page-title">Nuovo post</h1>
    </div>
    <div class="d-flex gap-2">
      <a class="btn btn-outline-secondary btn-sm" href="/dashboard">← Esci</a>
    </div>
  </div>

  <div class="alert alert-danger" id="err-msg" style="display:none" role="alert"></div>
  <div class="alert alert-success" id="ok-msg" style="display:none" role="status"></div>

  <div class="row g-3">

    <!-- ── FORM ── -->
    <div class="col-12 col-xl-7">

      <!-- 0. ASSISTENTE AI -->
      <details class="w-section" id="ai-section" open>
        <summary>
          <span>✦ Assistente AI</span>
          <span class="badge-num">compila automaticamente</span>
          <span class="arrow">▶</span>
        </summary>
        <div class="section-body">
          <p style="font-size:.78rem;color:#5a6882;margin:0 0 10px">Incolla il testo del volantino, aggiungi anche la foto, o usali insieme: l'AI compila tutti i campi del post.</p>
          <div class="ai-glow-wrap">
            <div class="ai-glow-inner">
              <textarea id="ai-text-input" rows="4"
                style="width:100%;border:1px solid #d1d9e0;border-radius:8px;padding:10px 12px;font-size:.85rem;font-family:inherit;resize:vertical;outline:none;color:#17324d;background:#fff;margin-bottom:10px;display:block"
                placeholder="Incolla qui il testo del volantino, dell'annuncio o del comunicato stampa…"></textarea>
              <input type="file" id="ai-image-file" accept="image/*" style="display:none" />
              <div class="vol-upload-area" id="vol-upload-area">
                <div class="vol-icon" id="vol-icon">📷</div>
                <div class="vol-info">
                  <div class="vup-label" id="vol-label">Aggiungi anche la foto <span style="font-weight:400;color:#8a9bb0;font-size:.9em">(opzionale)</span></div>
                  <div class="vup-sub" id="vol-sub">JPG · PNG · WebP · qualsiasi immagine con testo</div>
                </div>
                <button type="button" id="vol-btn"
                  style="font-size:.72rem;padding:4px 10px;border-radius:5px;border:1px solid #c8d2de;background:#fff;color:#17324d;cursor:pointer;flex-shrink:0">Scegli</button>
              </div>
              <div style="display:flex;align-items:center;gap:10px;margin-top:12px;flex-wrap:wrap">
                <button id="btn-ai-fill" type="button" class="btn btn-primary btn-sm">✦ Elabora e compila</button>
                <span id="ai-spinner" style="display:none;font-size:.78rem;color:#5a6882">⏳ Elaborazione AI in corso…</span>
              </div>
            </div>
          </div>
          <div class="ai-result-ok" id="ai-result-ok"></div>
          <div class="alert alert-danger mt-2 p-2" id="ai-err" style="display:none;font-size:.8rem" role="alert"></div>
        </div>
      </details>

      <!-- 1. IDENTITÀ -->
      <details class="w-section" open>
        <summary>
          <span>1 · Identità</span>
          <span class="badge-num">5 campi</span>
          <span class="arrow">▶</span>
        </summary>
        <div class="section-body">
          <div class="field-grid">
            <div class="f-cell span3">
              <label for="f-title">Titolo *</label>
              <input id="f-title" maxlength="120" placeholder="Titolo principale" />
              <span class="char-hint"><span id="title-count">0</span>/120</span>
            </div>
            <div class="f-cell span2">
              <label for="f-subtitle">Sottotitolo</label>
              <input id="f-subtitle" maxlength="160" placeholder="Taglio giornalistico o poetico" />
            </div>
            <div class="f-cell">
              <label for="f-category">Categoria *</label>
              <select id="f-category"></select>
            </div>
            <div class="f-cell span2">
              <label for="f-tone">Tono</label>
              <select id="f-tone">
                <option value="narrativo">Narrativo</option>
                <option value="istituzionale">Istituzionale</option>
                <option value="giornalistico">Giornalistico</option>
                <option value="conviviale">Conviviale</option>
              </select>
            </div>
            <div class="f-cell">
              <label for="f-target">Pubblico</label>
              <select id="f-target">
                <option value="">Tutti</option>
                <option value="famiglie">Famiglie</option>
                <option value="bambini">Bambini</option>
                <option value="giovani">Giovani</option>
                <option value="turisti">Turisti</option>
                <option value="escursionisti">Escursionisti</option>
                <option value="appassionati_natura">Appassionati natura</option>
              </select>
            </div>
            <div class="f-cell span3">
              <label for="f-excerpt">Descrizione breve (estratto)</label>
              <textarea id="f-excerpt" rows="2" maxlength="280" placeholder="Riassunto per anteprime e share social…"></textarea>
              <span class="char-hint"><span id="excerpt-count">0</span>/280</span>
            </div>
          </div>
        </div>
      </details>

      <!-- 2. TESTO -->
      <div class="content-wrap">
        <div class="content-header">2 · Testo completo *</div>
        <textarea id="f-content" placeholder="Inizia descrivendo di cosa si tratta, poi quando e dove si svolge.&#10;Racconta chi organizza, chi può partecipare e cosa ci sarà da fare o vedere.&#10;Chiudi con contatti, link utili o note aggiuntive."></textarea>
        <div class="px-3 pb-2 d-flex justify-content-end">
          <span style="font-size:.65rem;color:#8a9bb0"><span id="content-words">0</span> parole · <span id="content-count">0</span> car.</span>
        </div>
      </div>

      <!-- 3. EVENTO -->
      <details class="w-section">
        <summary>
          <span>3 · Date e luogo</span>
          <span class="badge-num">5 campi</span>
          <span class="arrow">▶</span>
        </summary>
        <div class="section-body">
          <div class="field-grid">
            <div class="f-cell">
              <label for="f-event-start">Data inizio</label>
              <input id="f-event-start" type="date" />
            </div>
            <div class="f-cell">
              <label for="f-event-end">Data fine</label>
              <input id="f-event-end" type="date" />
            </div>
            <div class="f-cell">
              <label for="f-event-time">Orario</label>
              <input id="f-event-time" maxlength="80" placeholder="Es. 10:00 – 23:00" />
            </div>
            <div class="f-cell span2">
              <label for="f-location">Luogo / sede</label>
              <input id="f-location" maxlength="180" placeholder="Es. Piazza Municipio" />
            </div>
            <div class="f-cell span3">
              <label for="f-address">Indirizzo completo</label>
              <input id="f-address" maxlength="240" placeholder="Via, numero, CAP, città" />
            </div>
          </div>
        </div>
      </details>

      <!-- 4. ORGANIZZAZIONE -->
      <details class="w-section">
        <summary>
          <span>4 · Organizzazione</span>
          <span class="badge-num">4 campi</span>
          <span class="arrow">▶</span>
        </summary>
        <div class="section-body">
          <div class="field-grid">
            <div class="f-cell span2">
              <label for="f-organizer">Organizzatore</label>
              <input id="f-organizer" maxlength="160" placeholder="Es. Pro Loco Rivalta sul Mincio" />
            </div>
            <div class="f-cell span2">
              <label for="f-contacts">Contatti</label>
              <input id="f-contacts" maxlength="240" placeholder="Tel, email o link pagina" />
            </div>
            <div class="f-cell span2">
              <label for="f-booking-url">Link prenotazione / iscrizione</label>
              <input id="f-booking-url" type="url" maxlength="500" placeholder="https://…" />
            </div>
            <div class="f-cell">
              <label for="f-price">Prezzo ingresso</label>
              <input id="f-price" maxlength="80" placeholder="Gratuito / €5" />
            </div>
