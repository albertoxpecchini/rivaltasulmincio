{
  // F5: avvia `npm run dev` (task «dev»), aspetta che Vite sia in ascolto
  // e apre il sito in Edge col debugger attaccato.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Sito (F5)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "dev",
      "sourceMapPathOverrides": {
        "/src/*": "${workspaceFolder}/src/*"
      }
    },
    {
      "name": "Prerender (build)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/prerender.ts",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
