{
  "version": "2.0.0",
  "tasks": [
    {
      // `npm run dev` come task in background: resta vivo dopo F5.
      // Il `problemMatcher` dice a VS Code quando Vite è in ascolto,
      // così il browser non parte prima che il server risponda.
      "label": "dev",
      "type": "npm",
      "script": "dev",
      "path": "",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(?!x)x$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*Local:.*http.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    },
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "typecheck",
      "type": "npm",
      "script": "typecheck",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$tsc"]
    }
  ]
}
