{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo 'Sito statico: nessuna build necessaria.'",
  "installCommand": "echo 'Nessuna dipendenza da installare.'",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/color-runner", "destination": "/color-walk", "permanent": true },
    { "source": "/color-runner-regolamento", "destination": "/color-walk-regolamento", "permanent": true },
    { "source": "/color-runner-domande", "destination": "/color-walk-domande", "permanent": true }
  ],
  "functions": {
    "api/meteo.mjs": { "maxDuration": 10 },
    "api/iscrizione-color-walk.mjs": { "maxDuration": 20 },
    "api/iscritti-color-walk.mjs": { "maxDuration": 25 },
    "api/conferma-color-walk.mjs": { "maxDuration": 25 }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    },
    {
      "source": "/assets/(.*\\.pdf)",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "attachment" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }]
    }
  ]
}
