<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <link rel="icon" href="/img/favicon.png" type="image/png" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard – Rivalta sul Mincio</title>
  <meta name="robots" content="noindex" />
  <link rel="stylesheet" href="/vendor/bootstrap-italia/css/bootstrap-italia.min.css" />
  <link rel="stylesheet" href="/rsm-bi.css" />
  <style>
    /* ── banner fotografico ── */
    .db-banner {
      position: relative;
      border-radius: 14px;
      overflow: hidden;
      padding: 36px 28px 28px;
      margin-bottom: 1.5rem;
      background: linear-gradient(150deg, #0a1f18 0%, #0d3326 35%, #155240 60%, #1c7a60 85%, #22a07e 100%);
      color: #fff;
    }
    .db-banner::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 60% 80% at 80% 20%, rgba(255,255,255,.06) 0%, transparent 60%),
        radial-gradient(ellipse 40% 60% at 20% 80%, rgba(34,160,126,.15) 0%, transparent 60%);
      pointer-events: none;
    }
    .db-banner-title {
      font-size: clamp(2rem, 5vw, 3.2rem);
      font-weight: 800;
      letter-spacing: -.03em;
      line-height: 1;
      margin: 0 0 4px;
      position: relative;
    }
    .db-banner-user {
      font-size: .78rem;
      opacity: .55;
      font-weight: 500;
      letter-spacing: .04em;
      position: relative;
      margin-bottom: 20px;
    }
    .db-stats {
      display: flex;
      gap: 24px;
      position: relative;
      margin-bottom: 22px;
    }
    .db-stat-num { font-size: 1.5rem; font-weight: 800; line-height: 1; }
    .db-stat-label { font-size: .63rem; opacity: .5; text-transform: uppercase; letter-spacing: .1em; margin-top: 3px; }
    .db-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      position: relative;
    }
    .db-action {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 6px 14px;
      border-radius: 999px;
      font-size: .76rem;
      font-weight: 600;
      text-decoration: none;
      border: 1px solid rgba(255,255,255,.22);
      color: rgba(255,255,255,.9);
      background: rgba(255,255,255,.08);
      transition: background .15s;
    }
    .db-action:hover { background: rgba(255,255,255,.18); color: #fff; }
    .db-action.primary { background: rgba(255,255,255,.2); border-color: rgba(255,255,255,.35); }

    /* ── kpi compatti ── */
    .db-kpi-num { font-size: 1.6rem; font-weight: 700; line-height: 1.1; margin: 6px 0 2px; }
    .db-kpi-label { font-size: .65rem; text-transform: uppercase; letter-spacing: .08em; color: #6c757d; }
    .db-kpi-meta { font-size: .72rem; margin-top: 2px; }

    /* ── sync note ── */
    #sync-note { font-size: .72rem; color: #6c757d; }

    /* ── chart bars (invariato) ── */
    .chart-bars { display: flex; align-items: flex-end; gap: 3px; height: 64px; }
    .chart-bars .bar { flex: 1; border-radius: 3px 3px 0 0; background: #0066cc; opacity: .7; min-height: 3px; transition: opacity .15s; }
    .chart-bars .bar:hover { opacity: 1; }
    .chart-labels { display: flex; gap: 3px; margin-top: 4px; }
    .chart-label { flex: 1; font-size: .58rem; color: #8a9bb0; text-align: center; overflow: hidden; white-space: nowrap; }
  </style>
</head>
<body>

<!--PARTIAL:nav-->

<main class="container rsm-page">

  <!-- BANNER FOTOGRAFICO -->
  <div class="db-banner">
    <div class="db-banner-title">Dashboard</div>
    <div class="db-banner-user" id="chip-user">@utente</div>
    <div class="db-stats">
      <div><div class="db-stat-num" id="hero-published">0</div><div class="db-stat-label">Online</div></div>
      <div><div class="db-stat-num" id="hero-drafts">0</div><div class="db-stat-label">Bozze</div></div>
      <div><div class="db-stat-num" id="hero-likes">0</div><div class="db-stat-label">Like</div></div>
    </div>
    <div class="db-actions">
      <a class="db-action primary" href="/write">+ Nuovo post</a>
      <a class="db-action" href="/">Vedi il sito</a>
      <a class="db-action" href="/category">Tutti i post</a>
      <a class="db-action" href="/modifica-profilo">Profilo</a>
    </div>
  </div>

  <!-- PERIODO + SYNC -->
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <label class="d-flex align-items-center gap-2 mb-0">
      <span class="small fw-semibold text-muted">Periodo</span>
      <select class="form-select form-select-sm w-auto" id="global-period" aria-label="Periodo">
        <option value="7d">7 giorni</option>
        <option value="30d">30 giorni</option>
        <option value="90d">90 giorni</option>
      </select>
    </label>
    <div id="sync-note">Caricamento…</div>
  </div>

  <!-- KPI -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
      <div class="card-wrapper h-100"><div class="card card-bg h-100"><div class="card-body">
        <div class="db-kpi-label">Post pubblicati</div>
        <div class="db-kpi-num" id="bc-val-posts">–</div>
        <div class="db-kpi-meta" id="bc-meta-posts"></div>
      </div></div></div>
    </div>
    <div class="col-12 col-md-4" id="analytics">
      <div class="card-wrapper h-100"><div class="card card-bg h-100"><div class="card-body">
        <div class="db-kpi-label">Interazioni</div>
        <div class="db-kpi-num" id="bc-val-inter">–</div>
        <div class="db-kpi-meta" id="bc-meta-inter"></div>
      </div></div></div>
    </div>
    <div class="col-12 col-md-4">
      <div class="card-wrapper h-100"><div class="card card-bg h-100"><div class="card-body">
        <div class="db-kpi-label">Commenti</div>
        <div class="db-kpi-num" id="bc-val-comments">–</div>
        <div class="db-kpi-meta" id="bc-meta-comments"></div>
      </div></div></div>
    </div>
  </div>

  <!-- CHART -->
  <div class="card-wrapper mb-4"><div class="card card-bg"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <div>
        <div class="db-kpi-label">Andamento</div>
        <strong class="small">Interazioni nel periodo</strong>
      </div>
      <div class="btn-group btn-group-sm" role="group">
        <button class="btn btn-outline-primary active" type="button" data-group="day">Giorno</button>
        <button class="btn btn-outline-primary" type="button" data-group="week">Sett.</button>
        <button class="btn btn-outline-primary" type="button" data-group="month">Mese</button>
      </div>
    </div>
    <div class="d-flex justify-content-end mb-1">
      <span class="small text-muted" id="chart-total">Totale: 0</span>
    </div>
    <div class="chart-bars" id="chart-bars"></div>
    <div class="chart-labels" id="chart-labels"></div>
  </div></div></div>

  <!-- LISTE -->
  <div class="row g-3">
    <div class="col-12 col-lg-4" id="contenuti"><div class="card-wrapper h-100"><div class="card card-bg h-100"><div class="card-body">
      <div class="db-kpi-label mb-2">Bozze</div>
      <div class="d-grid gap-3" id="drafts-list"></div>
    </div></div></div></div>

    <div class="col-12 col-lg-4"><div class="card-wrapper h-100"><div class="card card-bg h-100"><div class="card-body">
      <div class="db-kpi-label mb-2">Movimenti recenti</div>
      <div class="d-grid gap-3" id="recent-list"></div>
    </div></div></div></div>

    <div class="col-12 col-lg-4" id="media"><div class="card-wrapper h-100"><div class="card card-bg h-100"><div class="card-body">
      <div class="db-kpi-label mb-2">Notifiche</div>
      <div class="d-grid gap-3" id="notif-list"></div>
    </div></div></div></div>
  </div>

  <div class="callout note mt-3" id="empty-dashboard" style="display:none">
    <div class="callout-title">Nessun contenuto ancora</div>
    <a class="btn btn-primary mt-2" href="/write">+ Crea il primo post</a>
  </div>

</main>

<!--PARTIAL:footer-->

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
<script src="/supabase.config.js"></script>
<script>
(function () {
  if (typeof SUPABASE_URL === 'undefined' || SUPABASE_URL.includes('your-project')) return;

  const sb = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
  const $ = (id) => document.getElementById(id);

  const STATE = {
    period: '7d', group: 'day', session: null, profile: null,
    posts: [], comments: [], likes: [], notifications: [],
    totals: { comments: 0, likes: 0 },
    missing: { comments: false, likes: false, notifications: false },
  };

  const PERIOD_DAYS = { '7d': 7, '30d': 30, '90d': 90 };

  function escapeHtml(v) {
    return String(v || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }
  function isMissingRelationError(e) {
    const msg = String(e?.message || '').toLowerCase();
    return !!e && (e.code === '42P01' || e.code === 'PGRST205' || msg.includes('does not exist') || msg.includes('could not find the table'));
  }
  function fmtDate(iso) {
    if (!iso) return '-';
    return new Date(iso).toLocaleDateString('it-IT', { day: '2-digit', month: 'short' });
  }
  function relativeTime(iso) {
    if (!iso) return 'ora';
    const mins = Math.floor((Date.now() - new Date(iso).getTime()) / 60000);
    if (mins < 1) return 'adesso';
    if (mins < 60) return mins + ' min fa';
    const h = Math.floor(mins / 60);
    if (h < 24) return h + ' h fa';
    const d = Math.floor(h / 24);
    if (d < 7) return d + ' g fa';
    return fmtDate(iso);
  }
  function startOfDay(d) { const x = new Date(d); x.setHours(0,0,0,0); return x; }
  function rangeBounds(days) { const end = new Date(); return { end, start: new Date(end - days * 864e5) }; }
  function inRange(ts, s, e) { const v = new Date(ts).getTime(); return v >= s.getTime() && v <= e.getTime(); }
  function countByRange(items, getDate, s, e) { return items.filter(i => { const d = getDate(i); return d && inRange(d, s, e); }).length; }
  function percentChange(c, p) { if (p <= 0 && c <= 0) return 0; if (p <= 0) return 100; return Math.round(((c-p)/p)*100); }
  function deltaBadge(v) {
    if (v > 0) return `<span class="text-success fw-semibold">+${v}%</span>`;
    if (v < 0) return `<span class="text-danger fw-semibold">-${Math.abs(v)}%</span>`;
    return '<span class="text-muted fw-semibold">=0%</span>';
  }
  function emptyCallout(title, hint) {
    return `<div class="callout note"><p class="mb-1 small">${escapeHtml(title)}</p><p class="text-muted small mb-0">${escapeHtml(hint)}</p></div>`;
  }

  function renderKpis() {
    const days = PERIOD_DAYS[STATE.period] || 7;
    const label = days + ' g';
    const curr = rangeBounds(days);
    const prev = { end: new Date(curr.start - 1), start: new Date(+curr.start - days * 864e5) };

    const pub = STATE.posts.filter(p => p.published);
    const cP = countByRange(pub, p => p.published_at || p.created_at, curr.start, curr.end);
    const pP = countByRange(pub, p => p.published_at || p.created_at, prev.start, prev.end);
    const cL = countByRange(STATE.likes, x => x.created_at, curr.start, curr.end);
    const pL = countByRange(STATE.likes, x => x.created_at, prev.start, prev.end);
    const cC = countByRange(STATE.comments, x => x.created_at, curr.start, curr.end);
    const pC = countByRange(STATE.comments, x => x.created_at, prev.start, prev.end);

    function setKpi(valId, metaId, val, delta) {
      const ve = $(valId); const me = $(metaId);
      if (ve) ve.textContent = val;
      if (me) me.innerHTML = deltaBadge(delta) + ' <span class="text-muted">' + label + '</span>';
    }
    setKpi('bc-val-posts', 'bc-meta-posts', cP, percentChange(cP, pP));
    setKpi('bc-val-comments', 'bc-meta-comments', cC, percentChange(cC, pC));
    const ie = $('bc-val-inter'); const im = $('bc-meta-inter');
    if (ie) ie.textContent = cL + cC;
    if (im) im.innerHTML = deltaBadge(percentChange(cL+cC, pL+pC)) + ' <span class="text-muted">' + label + '</span>';

    const hp = $('hero-published'); const hd = $('hero-drafts'); const hl = $('hero-likes');
    if (hp) hp.textContent = pub.length;
    if (hd) hd.textContent = STATE.posts.filter(p => !p.published).length;
    if (hl) hl.textContent = STATE.totals.likes || 0;
  }

  function buildBuckets(start, end, group) {
    const items = [];
    let stepMs = 864e5;
    if (group === 'week') stepMs = 7 * 864e5;
    if (group === 'month') stepMs = 30 * 864e5;
    let cursor = startOfDay(start);
    while (cursor.getTime() < end.getTime()) {
      const next = new Date(cursor.getTime() + stepMs);
      items.push({ start: new Date(cursor), end: next });
      cursor = next;
      if (items.length > 120) break;
    }
    if (!items.length) items.push({ start: startOfDay(start), end });
    return items;
  }

  function renderChart() {
    const bars = $('chart-bars'); const labels = $('chart-labels'); const tot = $('chart-total');
    if (!bars || !labels) return;
    const days = PERIOD_DAYS[STATE.period] || 7;
    const { start, end } = rangeBounds(days);
    const buckets = buildBuckets(start, end, STATE.group);
    const events = [
      ...STATE.likes.filter(x => x.created_at).map(x => new Date(x.created_at).getTime()),
      ...STATE.comments.filter(x => x.created_at).map(x => new Date(x.created_at).getTime()),
    ];
    const values = buckets.map(b => events.filter(ts => ts >= b.start.getTime() && ts < b.end.getTime()).length);
    const sum = values.reduce((a,b) => a+b, 0);
    if (tot) tot.textContent = 'Totale: ' + sum;
    const max = Math.max(1, ...values);
    bars.innerHTML = values.map(v => `<div class="bar" style="height:${Math.max(3,Math.round(v/max*100))}%" data-v="${v}"></div>`).join('');
    labels.innerHTML = buckets.map((b, i) => {
      let l = fmtDate(b.start);
      if (STATE.group === 'week') l = 'W' + (i+1);
      if (STATE.group === 'month') l = new Date(b.start).toLocaleDateString('it-IT', { month: 'short' });
      return `<div class="chart-label">${l}</div>`;
    }).join('');
  }

  function renderRecent() {
    const wrap = $('recent-list'); if (!wrap) return;
    const recent = STATE.posts.slice().sort((a,b) => new Date(b.updated_at||b.created_at) - new Date(a.updated_at||a.created_at)).slice(0, 6);
    if (!recent.length) { wrap.innerHTML = emptyCallout('Nessun movimento.', 'Le modifiche appariranno qui.'); return; }
    wrap.innerHTML = recent.map(p => {
      const pill = p.published ? '<span class="badge bg-success rounded-pill">Online</span>' : '<span class="badge bg-warning rounded-pill">Bozza</span>';
      const href = p.published ? '/post?id=' + encodeURIComponent(p.id) : '/write?id=' + encodeURIComponent(p.id);
      return `<article class="border rounded p-2 d-grid gap-1">
        <div class="d-flex justify-content-between align-items-center gap-2">${pill}<span class="text-muted small">${relativeTime(p.updated_at||p.created_at)}</span></div>
        <strong class="small">${escapeHtml(p.title||'(Senza titolo)')}</strong>
        <div class="text-end"><a class="small fw-semibold" href="${href}">${p.published?'Apri':'Riprendi'}</a></div>
      </article>`;
    }).join('');
  }

  function renderDrafts() {
    const wrap = $('drafts-list'); if (!wrap) return;
    const drafts = STATE.posts.filter(p => !p.published).slice(0, 6);
    if (!drafts.length) { wrap.innerHTML = emptyCallout('Nessuna bozza.', 'Le bozze salvate appaiono qui.'); return; }
    wrap.innerHTML = drafts.map(p =>
      `<article class="border rounded p-2 d-grid gap-1">
        <div class="d-flex justify-content-between align-items-center gap-2">
          <span class="badge bg-warning rounded-pill">Bozza</span>
          <span class="text-muted small">${relativeTime(p.updated_at||p.created_at)}</span>
        </div>
        <strong class="small">${escapeHtml(p.title||'(Senza titolo)')}</strong>
        <div class="text-end"><a class="small fw-semibold" href="/write?id=${encodeURIComponent(p.id)}">Riprendi</a></div>
      </article>`
    ).join('');
  }

  function renderNotifications() {
    const wrap = $('notif-list'); if (!wrap) return;
    if (STATE.missing.notifications) { wrap.innerHTML = emptyCallout('Notifiche non attive.', 'Applica lo script Supabase per abilitarle.'); return; }
    const notifs = STATE.notifications.slice(0, 6);
    if (!notifs.length) { wrap.innerHTML = emptyCallout('Nessun segnale.', 'Like e commenti appariranno qui.'); return; }
    wrap.innerHTML = notifs.map(n => {
      const state = n.is_read ? '<span class="badge bg-secondary rounded-pill">Letta</span>' : '<span class="badge bg-primary rounded-pill">Nuova</span>';
      return `<article class="border rounded p-2 d-grid gap-1">
        <div class="d-flex justify-content-between align-items-center gap-2">
          <span class="badge bg-secondary rounded-pill">${n.type==='comment'?'Commento':'Like'}</span>${state}
          <span class="text-muted small">${relativeTime(n.created_at)}</span>
        </div>
        <strong class="small">${escapeHtml(n.message||'Nuova notifica')}</strong>
      </article>`;
    }).join('');
  }

  function renderEmptyState() {
    const el = $('empty-dashboard'); if (!el) return;
    el.style.display = STATE.posts.length ? 'none' : '';
  }

  function renderAll() {
    renderKpis(); renderChart(); renderRecent(); renderDrafts(); renderNotifications(); renderEmptyState();
    const note = $('sync-note');
    if (note) {
      const w = [];
      if (STATE.missing.likes) w.push('like');
      if (STATE.missing.comments) w.push('commenti');
      if (STATE.missing.notifications) w.push('notifiche');
      note.textContent = w.length
        ? 'Vista parziale: mancano ' + w.join(', ')
        : 'Aggiornato alle ' + new Date().toLocaleTimeString('it-IT', { hour: '2-digit', minute: '2-digit' });
    }
  }

  async function fetchPosts() {
    const { data, error } = await sb.from('posts')
      .select('id,title,excerpt,category,published,published_at,created_at,updated_at')
      .eq('user_id', STATE.session.user.id)
      .order('created_at', { ascending: false });
    if (error) throw error;
    STATE.posts = data || [];
  }

  async function fetchCommentsAndLikes() {
    STATE.comments = []; STATE.likes = []; STATE.totals.comments = 0; STATE.totals.likes = 0;
    STATE.missing.comments = false; STATE.missing.likes = false;
    const ids = STATE.posts.map(p => p.id).filter(Boolean);
    if (!ids.length) return;
    const since = new Date(Date.now() - 180 * 864e5).toISOString();
    const [cRes, lRes] = await Promise.all([
      sb.from('comments').select('id', { count: 'exact', head: true }).in('post_id', ids).eq('is_hidden', false),
      sb.from('post_likes').select('id', { count: 'exact', head: true }).in('post_id', ids)
    ]);
    if (cRes.error) { if (isMissingRelationError(cRes.error)) STATE.missing.comments = true; }
    else STATE.totals.comments = cRes.count || 0;
    if (lRes.error) { if (isMissingRelationError(lRes.error)) STATE.missing.likes = true; }
    else STATE.totals.likes = lRes.count || 0;
    const [cAll, lAll] = await Promise.all([
      sb.from('comments').select('id,post_id,created_at').in('post_id', ids).eq('is_hidden', false).gte('created_at', since).order('created_at', { ascending: false }).limit(5000),
      sb.from('post_likes').select('id,post_id,created_at').in('post_id', ids).gte('created_at', since).order('created_at', { ascending: false }).limit(5000)
    ]);
    if (cAll.error) { if (isMissingRelationError(cAll.error)) STATE.missing.comments = true; } else STATE.comments = cAll.data || [];
    if (lAll.error) { if (isMissingRelationError(lAll.error)) STATE.missing.likes = true; } else STATE.likes = lAll.data || [];
  }

  async function fetchNotifications() {
    STATE.notifications = []; STATE.missing.notifications = false;
    const res = await sb.from('notifications').select('id,type,message,is_read,created_at').eq('user_id', STATE.session.user.id).order('created_at', { ascending: false }).limit(30);
    if (res.error) { if (isMissingRelationError(res.error)) STATE.missing.notifications = true; return; }
    STATE.notifications = res.data || [];
  }

  async function refreshData() {
    await fetchPosts();
    await fetchCommentsAndLikes();
    await fetchNotifications();
    renderAll();
  }

  function bindUi() {
    $('global-period')?.addEventListener('change', () => {
      STATE.period = $('global-period').value;
      renderKpis(); renderChart();
    });
    document.querySelectorAll('[data-group]').forEach(btn => {
      btn.addEventListener('click', () => {
        STATE.group = btn.getAttribute('data-group');
        document.querySelectorAll('[data-group]').forEach(x => x.classList.remove('active'));
        btn.classList.add('active');
        renderChart();
      });
    });
  }

  async function init() {
    const { data: sessionData } = await sb.auth.getSession();
    STATE.session = sessionData?.session || null;
    if (!STATE.session) { window.location.href = '/login'; return; }
    const { data: profile, error } = await sb.from('profiles').select('id,username,display_name,avatar_emoji,avatar_color').eq('id', STATE.session.user.id).single();
    if (error || !profile) { window.location.href = '/login'; return; }
    STATE.profile = profile;
    const chip = $('chip-user');
    if (chip) chip.textContent = '@' + (profile.username || 'utente');
    bindUi();
    await refreshData();
    const hash = (window.location.hash || '').replace('#', '');
    if (hash === 'write') window.location.href = '/write';
    if (hash === 'posts') $('contenuti')?.scrollIntoView({ behavior: 'smooth' });
    if (hash === 'profile') window.location.href = '/modifica-profilo';
  }

  init();
})();
</script>

</body>
</html>
